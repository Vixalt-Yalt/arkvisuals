{
  "schemaVersion": 1,
  "id": "arkvisuals",
  "version": "${version}",
  "name": "ArkVisuals",
  "description": "A client-side visual customization suite with a configurable in-game studio.",
  "authors": ["ArkVisuals contributors"],
  "license": "MIT",
  "icon": "assets/arkvisuals/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": ["dev.arkvisuals.ArkVisualsClient"]
  },
  "mixins": ["arkvisuals.mixins.json"],
  "depends": {
    "fabricloader": ">=0.16.10",
    "minecraft": "~1.21.4",
    "java": ">=21",
    "fabric-api": "*"
  }
}
